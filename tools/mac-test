#!/bin/bash
#
# Builds a pushed branch on this Mac and runs its tests on an iOS Simulator.
#
#   tools/mac-test <branch> [--ui]
#
# The Mac half of developing on beepboop: there the code is written and pushed, here it is
# built and tested. Run it from a checkout kept for nothing else (a `git worktree`, see
# CLAUDE.md, "Testing on the Mac"), because it checks out whatever it is asked to test.
#
# Without --ui it runs little-chefTests only; with it, the UI smoke tests as well.
# MAC_TEST_SIMULATOR=<name> picks a simulator by name instead of the newest iPhone Pro.
#
# Written for macOS's bash 3.2: no associative arrays, no `mapfile`.

set -euo pipefail

usage() {
    echo "usage: tools/mac-test <branch> [--ui]" >&2
    exit 2
}

[ $# -ge 1 ] || usage
args=("$@")
branch="$1"
shift
ui=0
for arg in "$@"; do
    case "$arg" in
        --ui) ui=1 ;;
        *) usage ;;
    esac
done

[ "$(uname -s)" = "Darwin" ] || { echo "mac-test: needs macOS and Xcode" >&2; exit 1; }

cd "$(git rev-parse --show-toplevel)"

# Package resolution rewrites this when the committed pins are stale or a different Xcode formats
# it differently. In a test checkout that is the build's own output, not anyone's work, so it is
# put back rather than allowed to block the next run.
resolved=little-chef.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
git checkout --quiet -- "$resolved"

# A checkout with edits in it is someone's work, not a test bed.
if [ -n "$(git status --porcelain)" ]; then
    echo "mac-test: this checkout has uncommitted changes; refusing to check anything out" >&2
    git status --short >&2
    exit 1
fi

git fetch --prune --quiet origin
before="$(git hash-object tools/mac-test 2>/dev/null || true)"
git checkout --detach --quiet "origin/$branch"

# This file is part of what was just checked out. Running on would test the branch with the
# previous checkout's script, so start again with the branch's own, once.
# A branch from before the script existed has none, and is tested with this one.
after="$(git hash-object tools/mac-test 2>/dev/null || true)"
if [ -n "$after" ] && [ "$after" != "$before" ] && [ -z "${MAC_TEST_REEXEC:-}" ]; then
    MAC_TEST_REEXEC=1 exec tools/mac-test "${args[@]}"
fi
echo "== testing $branch at $(git log --oneline -1)"
echo "== $(xcodebuild -version | head -1)"

# MLX compiles Metal kernels, and since Xcode 26 the Metal compiler is a separate download.
# Without it the build fails minutes in, on the first .metal file; finding out here is instant.
if ! xcrun metal --version >/dev/null 2>&1; then
    echo "mac-test: no Metal Toolchain in this Xcode; install it with" >&2
    echo "    xcodebuild -downloadComponent MetalToolchain" >&2
    exit 1
fi

# An iPhone "Pro" on the newest iOS runtime that has one, else the newest runtime's first
# iPhone. A new runtime can ship with only an odd model or two, so a Pro on an older runtime is
# preferred to the first iPhone on the newest.
udid="$(MAC_TEST_SIMULATOR="${MAC_TEST_SIMULATOR:-}" xcrun simctl list devices available -j | /usr/bin/python3 -c '
import json, os, re, sys
devices = json.load(sys.stdin)["devices"]
wanted = os.environ.get("MAC_TEST_SIMULATOR")
def version(runtime):
    m = re.search(r"iOS-(\d+)-(\d+)", runtime)
    return (int(m.group(1)), int(m.group(2))) if m else None
runtimes = sorted((r for r in devices if version(r)), key=version, reverse=True)
if wanted:
    tests = [lambda d: d["name"] == wanted]
else:
    tests = [lambda d: d["name"].startswith("iPhone") and " Pro" in d["name"],
             lambda d: d["name"].startswith("iPhone")]
for test in tests:
    found = [(r, d) for r in runtimes for d in devices[r] if test(d)]
    if found:
        runtime, pick = found[0]
        print(pick["udid"])
        print("== simulator: %s, %s" % (pick["name"], runtime.split(".")[-1]), file=sys.stderr)
        break
')"
[ -n "$udid" ] || { echo "mac-test: no available iPhone simulator${MAC_TEST_SIMULATOR:+ named $MAC_TEST_SIMULATOR}" >&2; exit 1; }

# Its own DerivedData, kept between runs so a rebuild is incremental, and apart from Xcode's
# so a test run never invalidates the build of the project open in the IDE.
cache="$HOME/Library/Caches/little-chef-mac-test"
mkdir -p "$cache"
result="$cache/last.xcresult"
log="$cache/last.log"
rm -rf "$result"

only=(-only-testing:little-chefTests)
[ "$ui" = 1 ] && only=()

echo "== building and testing (log: $log)"
status=0
xcodebuild test \
    -project little-chef.xcodeproj \
    -scheme little-chef \
    -configuration Debug \
    -destination "id=$udid" \
    -derivedDataPath "$cache/DerivedData" \
    -resultBundlePath "$result" \
    ${only[@]+"${only[@]}"} \
    >"$log" 2>&1 || status=$?

if [ -d "$result" ]; then
    xcrun xcresulttool get test-results summary --path "$result" --compact 2>/dev/null \
        | /usr/bin/python3 -c '
import json, sys
s = json.load(sys.stdin)
print("== result: %s, %s passed, %s failed, %s skipped" % (
    s.get("result"), s.get("passedTests"), s.get("failedTests"), s.get("skippedTests")))
for f in s.get("testFailures", []):
    print("FAIL %s: %s" % (f.get("testName"), f.get("failureText")))
' || echo "== (could not read the result bundle: $result)"
fi

# Said out loud, because it means the committed file is out of step with what Xcode resolves.
if ! git diff --quiet -- "$resolved"; then
    echo "== note: package resolution changed Package.resolved; compared with the committed one:"
    git show "HEAD:$resolved" >"$cache/Package.resolved.committed"
    /usr/bin/python3 - "$cache/Package.resolved.committed" "$resolved" <<'PY' || true
import json, sys
def pins(path):
    with open(path) as f:
        return {p["identity"]: p["state"].get("version") or p["state"].get("revision", "")[:12]
                for p in json.load(f)["pins"]}
old, new = pins(sys.argv[1]), pins(sys.argv[2])
for name in sorted(set(old) | set(new)):
    if old.get(name) != new.get(name):
        print("   %s: %s -> %s" % (name, old.get(name, "(none)"), new.get(name, "(none)")))
if old == new:
    print("   (the same pins, only reformatted)")
PY
    cp "$resolved" "$cache/Package.resolved"
    echo "   (Xcode's version saved to $cache/Package.resolved; the checkout's is put back)"
    git checkout --quiet -- "$resolved"
fi

if [ "$status" -ne 0 ]; then
    echo "== xcodebuild exited $status; the errors in the log:"
    grep -E "error:|\*\* (BUILD|TEST) FAILED" "$log" | head -40 || tail -40 "$log"
fi
exit "$status"
